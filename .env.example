# Скопируйте в .env и при необходимости измените. Любой параметр config/robot.toml
# задаётся переменной ROBOT_<РАЗДЕЛ>_<ПАРАМЕТР>.

POSTGRES_PASSWORD=robot
ROBOT_PORT=8000

# Демо-режим: встроенная копия структуры сайта ИРНИТУ (без доступа в Интернет)
ROBOT_APP_DEMO=false

# LLM: none | ollama | openai
ROBOT_LLM_PROVIDER=none
# Ollama из docker compose --profile llm:
# ROBOT_LLM_PROVIDER=ollama
# ROBOT_LLM_BASE_URL=http://ollama:11434
# ROBOT_LLM_MODEL=qwen2.5:7b-instruct
# Внешний OpenAI-совместимый сервис:
# ROBOT_LLM_PROVIDER=openai
# ROBOT_LLM_BASE_URL=https://api.example.com/v1
# ROBOT_LLM_MODEL=model-name
# ROBOT_LLM_API_KEY=...
